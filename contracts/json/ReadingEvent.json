{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "description": "ISO 时间戳，引擎以事件时间为准（可复现回放）"
        },
        "event_id": {
          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "session_start"
        },
        "material": {
          "type": "object",
          "properties": {
            "material_id": {
              "type": "string"
            },
            "topics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "difficulty": {
              "type": "string",
              "description": "难度描述，如 band 提示"
            },
            "length_words": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "summary": {
              "type": "string",
              "description": "正文摘要"
            },
            "text": {
              "description": "正文全文（可选），用于知识点曝光记账",
              "type": "string"
            }
          },
          "required": [
            "material_id",
            "topics",
            "difficulty",
            "length_words",
            "summary"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "material"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "description": "ISO 时间戳，引擎以事件时间为准（可复现回放）"
        },
        "event_id": {
          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "session_end"
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
