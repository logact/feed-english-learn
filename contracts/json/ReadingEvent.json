          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "word_lookup"
        },
        "lemma": {
          "type": "string"
        },
        "item_type": {
          "default": "word",
          "type": "string",
          "enum": [
            "word",
            "phrase"
          ]
        },
        "sentence": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "lemma",
        "item_type",
        "sentence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "description": "ISO 时间戳，引擎以事件时间为准（可复现回放）"
        },
        "event_id": {
          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "word_known"
        },
        "lemma": {
          "type": "string"
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "lemma"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
