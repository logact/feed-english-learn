        "topic": {
          "type": "string"
        },
        "difficulty": {
          "description": "难度显式反馈;阶段检查滞回 gate 的辅助信号",
          "type": "string",
          "enum": [
            "too_easy",
            "just_right",
            "too_hard"
          ]
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "material_id"
      ],
      "additionalProperties": false
    }
  ]
