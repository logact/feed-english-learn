        },
        "type": {
          "type": "string",
          "const": "material_completed"
        },
        "material_id": {
          "type": "string"
        },
        "completion_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "words_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "material_id",
        "completion_rate",
        "duration_ms",
        "words_read"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "description": "ISO 时间戳，引擎以事件时间为准（可复现回放）"
        },
        "event_id": {
          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "material_abandoned"
        },
        "material_id": {
          "type": "string"
        },
        "completion_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "words_read": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "user_id",
        "session_id",
        "ts",
        "type",
        "material_id",
        "completion_rate",
        "duration_ms",
        "words_read"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "ts": {
          "type": "string",
          "description": "ISO 时间戳，引擎以事件时间为准（可复现回放）"
        },
        "event_id": {
          "description": "客户端幂等键：重试必须携带同一 event_id，服务端按它去重",
          "type": "string"
        },
        "type": {
