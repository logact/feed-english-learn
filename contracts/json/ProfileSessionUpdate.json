{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reading_state": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "target_lookup_rate": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "comfortable_length_words": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_length_words": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reading_speed_wpm": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "evidence": {
          "type": "string"
        }
      },
      "required": [
        "evidence"
      ],
      "additionalProperties": false
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "note": {
            "type": "string",
            "description": "兴趣的细微差别备注"
          }
        },
        "required": [
          "topic",
          "weight",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "knowledge_annotations": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string"
          },
          "suggest_state": {
            "type": "string",
            "enum": [
              "new",
              "supported",
              "familiar",
              "mastered",
              "fading"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "suggest_state",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "reading_state",
    "interests",
    "notes",
    "knowledge_annotations"
  ],
  "additionalProperties": false
}